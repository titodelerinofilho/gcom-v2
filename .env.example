# make env / make init geram automaticamente os segredos locais vazios.
COMPOSE_PROJECT_NAME=gcom
BIND_IP=127.0.0.1
HTTP_PORT=8080
APP_SECRET=
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=gcom
DATABASE_USER=gcom_app
DATABASE_PASSWORD=
DATABASE_SERVER_VERSION=17
# Conta administrativa exclusiva para inicialização e backups.
DATABASE_OWNER_USER=gcom_owner
DATABASE_OWNER_PASSWORD=
# Credenciais Oracle são fornecidas pelo DBA; não são geradas pelo GCOM.
# O legado usa SID WINT; confirme host/porta e SID com o DBA.
ORACLE_DSN='oci:dbname=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=192.168.1.10)(PORT=1521))(CONNECT_DATA=(SID=WINT)));charset=AL32UTF8'
ORACLE_USER=GCOM_READONLY
ORACLE_PASSWORD=
DEFAULT_URI=http://localhost:8080
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
TZ=UTC
# Rotina 749: PCLANC por NUMTRANS. 0 desativa a consulta (referência manual).
WINTHOR_749_LOOKUP_ENABLED=1

# Event listeners for operational logs (financial audit remains enabled).
LOG_REQUESTS=1
LOG_RESPONSES=1
LOG_EXCEPTIONS=1
LOG_DATABASE=1
